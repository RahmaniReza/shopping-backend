<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{32}) [id:%X{requestId:--}] - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="HttpCallLogger" level="INFO"/>
    <logger name="StatusPages" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.eclipse.jetty" level="INFO"/>
</configuration>