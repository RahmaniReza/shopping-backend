# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=8080

# ==============================================================================
# JWT Authentication
# ==============================================================================
# Generate a random 64-char string for production
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ISSUER=com.reza.shopping

# ==============================================================================
# Database Configuration (Docker Compose)
# ==============================================================================
# These variables configure the PostgreSQL container when running via docker-compose
POSTGRES_DB=shopping_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password

# ==============================================================================
# Database Configuration (Direct Local Run / Production Overrides)
# ==============================================================================
# Uncomment and configure if running the application directly outside docker-compose
# (e.g., ./gradlew run or via IDE against a local/remote PostgreSQL instance)
# DATABASE_URL=jdbc:postgresql://localhost:5432/shopping_db
# DB_USER=postgres
# DB_PASSWORD=postgres_secure_password
# DB_DRIVER=org.postgresql.Driver
